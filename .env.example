# Port reserved for wce/web in portfolio-port-governance.
# Any change requires a new reservation in the registry.
WCE_HOST_PORT=3018

# Official public URLs (HTTPS). Empty uses app/public_identity.py defaults;
# networks without a confirmed default remain "Coming soon" in the footer.
WCE_GITHUB_URL=https://github.com/wce-research
WCE_X_URL=https://x.com/WCELabs
WCE_LINKEDIN_URL=
WCE_INSTAGRAM_URL=https://www.instagram.com/wcelabs/

# Public identity: official address only; empty = no contact displayed.
PUBLIC_CONTACT_EMAIL=
# Enable only after public verification of https://github.com/wce-research/wce
PUBLIC_WCE_REPO_ENABLED=true
