# Port réservé pour wce/web dans portfolio-port-governance.
# Toute modification impose une nouvelle réservation dans le registre.
WCE_HOST_PORT=3018

# URL publiques officielles (HTTPS). Vides = entrée « À venir » dans le footer.
# Renseigner ces valeurs dans .env, puis lancer make docker-up.
WCE_GITHUB_URL=
WCE_X_URL=
WCE_LINKEDIN_URL=
WCE_INSTAGRAM_URL=
