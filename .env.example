# Port réservé pour wce/web dans portfolio-port-governance.
# Toute modification impose une nouvelle réservation dans le registre.
WCE_HOST_PORT=3018

# URL publiques officielles (HTTPS). Vides = entrée « À venir » dans le footer.
# Renseigner ces valeurs dans .env, puis lancer make docker-up.
WCE_GITHUB_URL=https://github.com/wce-research
WCE_X_URL=
WCE_LINKEDIN_URL=
WCE_INSTAGRAM_URL=

# Identité publique : adresse officielle uniquement ; vide = aucun contact affiché.
PUBLIC_CONTACT_EMAIL=
# Activer seulement après vérification publique de https://github.com/wce-research/wce
PUBLIC_WCE_REPO_ENABLED=false
